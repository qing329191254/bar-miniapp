# 本地 docker-compose（默认）
MYSQL_URL=mysql+pymysql://wanka:wanka@127.0.0.1:3308/wanka
REDIS_URL=redis://127.0.0.1:6379/0

# 微信云托管：开通 MySQL 后填下面四项（不要再用 127.0.0.1）
# MYSQL_ADDRESS=10.x.x.x:3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=wanka
# REDIS_URL=redis://:密码@内网地址:6379/0

# 微信小程序登录（只放服务端，不要写进小程序）
# WX_APPID=wxXXXXXXXXXXXXXXXX
# WX_SECRET=

# 登录令牌签名密钥（云托管建议单独配置为足够长的随机字符串）
# SESSION_SECRET=

# 对象存储（云托管会自动注入 CBR_ENV_ID；以下仅在桶或域名变更时覆盖）
# COS_PUBLIC_BASE=https://7072-prod-d2gc6jcwy846bd613-1476141553.cos.ap-shanghai.myqcloud.com
